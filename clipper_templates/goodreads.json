{
	"schemaVersion": "0.1.0",
	"name": "Goodreads",
	"behavior": "create",
	"noteContentFormat": "# Goodreads Description \n{{selector:.BookPageMetadataSection__description}}\n\n{{selector:.BookPageMetadataSection__genres .BookPageMetadataSection__genreButton .Button__labelItem|join|replace:\" \":\"-\"}}\n\n## Personal Impressions\n\n### Quotes",
	"properties": [
		{
			"name": "MoC",
			"value": "[[Books]]",
			"type": "text"
		},
		{
			"name": "title",
			"value": "{{schema:name}}",
			"type": "text"
		},
		{
			"name": "author",
			"value": "{{schema:author[*].name|wikilink|join}}",
			"type": "multitext"
		},
		{
			"name": "year",
			"value": "{{selector:p[data-testid='publicationInfo']|split:\\\"First published \\\"|slice:1|date:\\\"YYYY\\\"}}",
			"type": "number"
		},
		{
			"name": "scoreGr",
			"value": "{{schema:aggregateRating.ratingValue}}",
			"type": "number"
		},
		{
			"name": "rating",
			"value": "",
			"type": "number"
		},
		{
			"name": "year read",
			"value": "",
			"type": "text"
		},
		{
			"name": "created",
			"value": "{{date}}",
			"type": "date"
		},
		{
			"name": "tags",
			"value": "{{selector:.BookPageMetadataSection__genres .BookPageMetadataSection__genreButton .Button__labelItem|join|replace:\\\" \\\":\\\"-\\\"|replace:\\\",\\\":\\\", genres/\\\"}}",
			"type": "multitext"
		}
	],
	"triggers": [
		"https://www.goodreads.com/book/"
	],
	"noteNameFormat": "{{selector:.BookPageTitleSection__title h1}}",
	"path": ""
}